# Bind to 0.0.0.0 for the live preview. Web calls remain same-origin.
PORT=8000
RELAY_DEMO_ENABLED=1
# In production, set DEMO_ENABLED=0 and use a long random encryption secret.
RELAY_SECRET_KEY=
RELAY_ALLOWED_ORIGINS=
# Optional persistent volume. Default: backend/data.
# RELAY_DATA_DIR=/path/to/persistent/data
META_API_VERSION=v23.0
# Required for live, signature-verified status and opt-out webhooks.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Business credentials are connected in Settings; stored encrypted server-side.
